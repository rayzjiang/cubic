# app/.env.production — PUBLIC prod config baked into the packaged build (§E packaging).
#
# Read at build time by electron.vite.config.ts (only when CUBIC_BUILD=prod) and `define`-injected
# into the main bundle as __CUBIC_*__ constants, because a double-clicked .app has an EMPTY
# process.env. Every value here is PUBLIC BY DESIGN and safe to commit:
#   - SUPABASE_ANON_KEY : the publishable anon key (ships in every Supabase client; protected by
#                         Row Level Security + the user's JWT, NOT by secrecy). The service_role key
#                         is NEVER here — it lives only in the Worker/edge functions.
#   - POSTHOG_KEY       : a write-only ingest key (can only send events, never read analytics).
#   - CUBIC_PROXY_URL   : just an address; every request is re-authed by JWT + entitlement.
# The real secrets (service_role, ANTHROPIC_API_KEY) never ship — they live only server-side.
# CUBIC_ENV is NOT set here; a packaged build force-bakes it to 'prod'.
#
# >>> SETUP: `cp .env.production.example .env.production` then fill your real prod values. <<<
# The real .env.production is gitignored (not because the values are secret — they're public — but
# to avoid secret-scanner false positives like GitGuardian flagging any .env.production by pattern).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
POSTHOG_KEY=
CUBIC_PROXY_URL=https://YOUR-WORKER.workers.dev
