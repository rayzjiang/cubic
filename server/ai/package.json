{
  "name": "cubic-ai",
  "version": "0.1.0",
  "description": "Claude API backend / agent brain for Cubic",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node tests/context-live.mjs"
  },
  "dependencies": {
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  }
}
