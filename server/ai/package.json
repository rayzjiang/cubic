{
  "name": "cubic-ai",
  "version": "0.1.0",
  "description": "Claude API backend / agent brain for Cubic",
  "main": "build/index.js",
  "types": "build/types/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir build/types",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node tests/context-live.mjs",
    "test:chat": "node tests/chat-live.mjs",
    "test:agent": "node tests/agent-live.mjs",
    "test:tools": "node tests/tools-live.mjs",
    "test:drift": "npm run build && node tests/drift-guard.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "dotenv": "^17.4.2",
    "ws": "^8.20.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  }
}
