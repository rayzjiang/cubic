{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // `@secrets` is the crown-jewels chokepoint. tsc + the editor always resolve it to the
    // type-correct empty stub (inside rootDir); esbuild aliases it to the REAL proxy secrets
    // for direct-local dev and back to the stub for the prod build (see scripts/build-ai.mjs).
    "paths": { "@secrets": ["./src/secrets/stub.ts"] },
  },
  "include": ["src/**/*.ts"],
}
