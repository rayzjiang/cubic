{
  "name": "cubic-ae-bridge",
  "version": "2.0.0",
  "description": "Cubic After Effects bridge — WS transport + ExtendScript handlers + CEP extension, with an optional MCP-server dev interface",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build:server": "node scripts/build-backend.mjs --server",
    "build:serve": "node scripts/build-backend.mjs --serve",
    "build:backend": "node scripts/build-backend.mjs",
    "build:plugin": "node scripts/build-cep-extension.mjs",
    "build": "npm run build:backend && npm run build:plugin",
    "install-plugin": "node install-cep-extension.js",
    "install-plugin:dry": "node install-cep-extension.js --dry-run",
    "start": "node build/index.js",
    "serve": "node build/serve.js",
    "postinstall": "npm run build",
    "test:unit": "vitest run",
    "test": "node scripts/preflight.mjs && node test-integration.mjs",
    "test:write": "node scripts/preflight.mjs && node test-integration.mjs --write",
    "test:clean": "node scripts/preflight.mjs && node test-integration.mjs --cleanup-only",
    "test:write-clean": "node scripts/preflight.mjs && node test-integration.mjs --write --cleanup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cubic-ai": "file:../ai",
    "ws": "^8.20.1",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  }
}
