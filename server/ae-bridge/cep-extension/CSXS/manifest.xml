<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="6.0"
                   ExtensionBundleId="com.cubic.ae-bridge"
                   ExtensionBundleVersion="2.0.0"
                   ExtensionBundleName="Cubic">
  <ExtensionList>
    <Extension Id="com.cubic.ae-bridge.panel" Version="2.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.cubic.ae-bridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- Enable Node.js so the panel can fs.watch ~/.cubic/conn.json (event-driven wake,
               zero idle polling) and read it directly. Standard CEP flag (Adobe's samples use it). -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <!-- Invisible background worker (Adobe's CEP_HTML_Invisible_Extension recipe):
               Custom UI type = never docked/shown, no workspace persistence, no Window menu.
               AutoVisible=false + StartOn = loads when AE activates, then runs invisibly and
               stays connected. AE's StartOn event support is version-specific — verify live. -->
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>100</Height><Width>100</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
