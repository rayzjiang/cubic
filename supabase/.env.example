# Copy to supabase/.env and fill in. TEST MODE values only for local dev.
# `supabase functions serve --env-file supabase/.env` loads these into the
# Edge Function runtime. NEVER commit the real .env (gitignored).

# Stripe TEST-MODE secret key (sk_test_...). From the Stripe dashboard, test mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret. `stripe listen` prints this as whsec_... — paste it here,
# then restart `functions serve`. In prod this is the dashboard endpoint's secret.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Supabase env: do NOT set SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# here for local dev — `supabase functions serve` auto-injects them with the correct
# IN-CONTAINER addresses. Setting them to 127.0.0.1 breaks the function (127.0.0.1
# inside the runtime container points at the function itself, not Supabase).
# Only set these in the PRODUCTION deploy (Supabase dashboard secrets), where the
# Worker/functions reach Supabase over the public URL.
