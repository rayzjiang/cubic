{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // src ONLY. `types` above deliberately omits node, so the Worker source can't use a Node API and
  // still typecheck — the runtime has no Node. The tests DO run in Node (vitest reads files, execs
  // scripts), so they typecheck separately via tsconfig.tests.json, which adds the node types.
  "include": ["src/**/*.ts"]
}
