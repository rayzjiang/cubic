{
  "name": "cubic-proxy",
  "version": "0.1.0",
  "description": "Cloudflare Worker LLM proxy — holds the Anthropic key + injects the secret system prompt/tool catalog (Phase 5 §A)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "gen:command-names": "node scripts/gen-command-names.mjs",
    "mint:test-jwt": "node scripts/mint-test-jwt.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7",
    "wrangler": "^4.86.0"
  }
}
